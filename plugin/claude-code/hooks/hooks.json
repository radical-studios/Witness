{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/witness.sh\" post-tool-use",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Bash|mcp__.*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/witness.sh\" post-tool-use-failure",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|NotebookEdit|mcp__.*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/witness.sh\" pre-tool-use",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|NotebookEdit|mcp__.*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/witness.sh\" session-end",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/witness.sh\" session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/witness.sh\" stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/witness.sh\" user-prompt-submit",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
